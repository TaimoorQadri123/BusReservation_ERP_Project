@model List<BusReservationERP.ViewModels.BookingGroupViewModel>

@{
    ViewData["Title"] = "Booking List";
}

<h2>Booking List</h2>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<a asp-controller="Booking" asp-action="Create" class="btn btn-primary mb-3">+ New Booking</a>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>Passenger</th>
            <th>Phone</th>
            <th>Seats</th>
            <th>Trip</th>
            <th>Boarding</th>
            <th>Drop</th>
            <th>Status</th>
            <th>Action</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var group in Model)
        {
            <tr>
                <td>@group.PassengerName</td>
                <td>@group.PassengerPhone</td>
                <td>
                    @string.Join(", ", group.SeatNumbers)
                    <span class="badge bg-secondary">@group.SeatNumbers.Count seat@(group.SeatNumbers.Count > 1 ? "s" : "")</span>
                </td>
                <td>
                    @group.Trip?.Bus?.BusNumber
                    (@group.Trip?.DepartureDate.ToString("dd-MMM-yyyy") @group.Trip?.DepartureTime)
                </td>
                <td>@group.BoardingStop?.StopName</td>
                <td>@group.DropStop?.StopName</td>
                <td>@group.BookingStatus</td>
                <td>
                    @if (group.BookingStatus != "Cancelled")
                    {
                        <form asp-controller="Booking" asp-action="Cancel" method="post" style="display:inline">
                            <input type="hidden" name="id" value="@group.SampleBookingId" />
                            <button type="submit" class="btn btn-sm btn-danger"
                                    onclick="return confirm('Kya aap ye poori booking (saari seats) cancel karna chahte hain?');">
                                Cancel All
                            </button>
                        </form>
                    }
                </td>
                <td>
                    @if (group.BookingStatus != "Cancelled")
                    {
                        <form asp-controller="Booking" asp-action="Cancel" method="post" style="display:inline">
                            <input type="hidden" name="id" value="@group.SampleBookingId" />
                            @* <button type="submit" class="btn btn-sm btn-danger"
                                    onclick="return confirm('Kya aap ye poori booking (saari seats) cancel karna chahte hain?');">
                                Cancel All
                            </button> *@
                        </form>
                    }

                    <form asp-controller="Booking" asp-action="Delete" method="post" style="display:inline">
                        <input type="hidden" name="id" value="@group.SampleBookingId" />
                        <button type="submit" class="btn btn-sm btn-outline-danger"
                                onclick="return confirm('Kya aap ye booking record poori tarah delete karna chahte hain? Ye wapas nahi ho sakta.');">
                            Delete
                        </button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>
@model List<BusReservationERP.ViewModels.BookingGroupViewModel>

@{
    ViewData["Title"] = "Booking List";
}

<h2>Booking List</h2>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<a asp-controller="Booking" asp-action="Create" class="btn btn-primary mb-3">+ New Booking</a>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>Passenger</th>
            <th>Phone</th>
            <th>Seats</th>
            <th>Trip</th>
            <th>Boarding</th>
            <th>Drop</th>
            <th>Status</th>
            <th>Payment</th>
            <th>Action</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var group in Model)
        {
            <tr>
                <td>@group.PassengerName</td>
                <td>@group.PassengerPhone</td>
                <td>
                    @string.Join(", ", group.SeatNumbers)
                    <span class="badge bg-secondary">@group.SeatNumbers.Count seat@(group.SeatNumbers.Count > 1 ? "s" : "")</span>
                </td>
                <td>
                    @group.Trip?.Bus?.BusNumber
                    (@group.Trip?.DepartureDate.ToString("dd-MMM-yyyy") @group.Trip?.DepartureTime)
                </td>
                <td>@group.BoardingStop?.StopName</td>
                <td>@group.DropStop?.StopName</td>
                <td>@group.BookingStatus</td>
                <td>
                    @if (group.BookingStatus != "Cancelled")
                    {
                        <form asp-controller="Booking" asp-action="Cancel" method="post" style="display:inline">
                            <input type="hidden" name="id" value="@group.SampleBookingId" />
                            <button type="submit" class="btn btn-sm btn-danger"
                                    onclick="return confirm('Do you want to cancel this entire booking (all seats)?');">
                                Cancel All
                            </button>
                        </form>

                        <a asp-controller="Payment" asp-action="Create" asp-route-groupId="@group.BookingGroupId" class="btn btn-sm btn-primary">
                            Add Payment
                        </a>
                    }

                    <form asp-controller="Booking" asp-action="Delete" method="post" style="display:inline">
                        <input type="hidden" name="id" value="@group.SampleBookingId" />
                        <button type="submit" class="btn btn-sm btn-outline-danger mt-1"
                                onclick="return confirm('Do you want to permanently delete this booking record? This action cannot be undone.');">
                            Delete
                        </button>
                    </form>
                </td>
                <td>@group.BookingStatus</td>
                <td>
                    @if (group.PaymentStatus == "Not Recorded")
                    {
                        <span class="badge bg-secondary">Not Recorded</span>
                    }
                    else if (group.PaymentStatus == "Paid")
                    {
                        <span class="badge bg-success">Paid (@group.PaymentAmount)</span>
                    }
                    else if (group.PaymentStatus == "Partial")
                    {
                        <span class="badge bg-warning text-dark">Partial (@group.PaymentAmount)</span>
                    }
                    else
                    {
                        <span class="badge bg-danger">Pending</span>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>
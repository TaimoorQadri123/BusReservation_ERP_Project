@model BusReservationERP.ViewModels.BookingViewModel

@{
    ViewData["Title"] = "New Booking";
}

<style>
    .page-head {
        margin-bottom: 20px;
    }

        .page-head h2 {
            font-size: 22px;
            font-weight: 700;
            color: #0b1c30;
            margin: 0;
        }

        .page-head .sub {
            font-size: 13px;
            color: #747685;
            margin-top: 2px;
        }

    /* ===== Form cards ===== */
    .form-card {
        background: #fff;
        border-radius: 10px;
        box-shadow: 0 1px 6px rgba(0,0,0,0.06);
        padding: 24px;
        margin-bottom: 18px;
    }

        .form-card .card-title {
            font-size: 15px;
            font-weight: 700;
            color: #0b1c30;
            margin: 0 0 16px 0;
            padding-bottom: 12px;
            border-bottom: 1px solid #eef1fa;
        }

        .form-card .form-label {
            font-size: 13px;
            font-weight: 600;
            color: #434655;
            margin-bottom: 6px;
        }

        .form-card .form-control {
            border: 1px solid #d5dbec;
            border-radius: 8px;
            padding: 10px 14px;
            font-size: 14px;
            color: #0b1c30;
            background-color: #f8f9ff;
        }

            .form-card .form-control:focus {
                background-color: #fff;
                border-color: #0037b0;
                box-shadow: 0 0 0 3px #dce1ff;
            }

        .form-card .text-danger {
            font-size: 13px;
        }

    /* ===== Selected seats summary ===== */
    #selectedSeatsSummary {
        background: #eff4ff;
        border: 1px solid #dce9ff;
        border-left: 4px solid #0037b0;
        border-radius: 8px;
        padding: 12px 16px;
        font-size: 14px;
        font-weight: 500;
        color: #0b1c30;
    }

    /* ===== Buttons ===== */
    .form-actions {
        display: flex;
        gap: 10px;
        margin-top: 18px;
    }

    .btn-brand {
        background: #0037b0;
        color: #fff;
        border: none;
        border-radius: 8px;
        font-weight: 600;
        font-size: 14px;
        padding: 10px 24px;
    }

        .btn-brand:hover {
            background: #00247d;
            color: #fff;
        }

    .btn-soft {
        background: #eff4ff;
        color: #434655;
        border: 1px solid #dce9ff;
        border-radius: 8px;
        font-weight: 500;
        font-size: 14px;
        padding: 10px 24px;
    }

        .btn-soft:hover {
            background: #dce9ff;
            color: #0b1c30;
        }

    /* ===== Seat map ===== */
    .seat-legend {
        display: flex;
        gap: 18px;
        margin-bottom: 14px;
        flex-wrap: wrap;
    }

    .legend-item {
        display: flex;
        align-items: center;
        gap: 6px;
        font-size: 13px;
        color: #434655;
    }

    .legend-box {
        width: 16px;
        height: 16px;
        border-radius: 4px;
        flex-shrink: 0;
    }

    .legend-available {
        background-color: #28a745;
    }

    .legend-booked {
        background-color: #dc3545;
    }

    .legend-selected {
        background-color: #0037b0;
    }

    .seat-map-card {
        background: #fff;
        border-radius: 10px;
        box-shadow: 0 1px 6px rgba(0,0,0,0.06);
        padding: 20px;
        position: sticky;
        top: 80px;
    }

        .seat-map-card .card-title {
            font-size: 15px;
            font-weight: 700;
            color: #0b1c30;
            margin: 0 0 4px 0;
        }

        .seat-map-card .hint {
            font-size: 13px;
            color: #747685;
            margin-bottom: 14px;
        }

    .bus-body {
        background: #f8f9ff;
        border: 1px solid #dce9ff;
        border-radius: 14px;
        padding: 14px;
    }

    .driver-box {
        background: #dce9ff;
        color: #0037b0;
        padding: 6px 14px;
        border-radius: 8px;
        font-size: 13px;
        font-weight: 600;
        width: fit-content;
        margin-bottom: 14px;
    }

    .seat-map-scroll-area {
        max-height: 460px;
        overflow-y: auto;
        padding-right: 6px;
    }

    .seat-row {
        display: grid;
        grid-template-columns: 1fr 1fr 30px 1fr 1fr;
        gap: 8px;
        margin-bottom: 10px;
        align-items: center;
    }

    .seat-btn {
        height: 42px;
        border: none;
        border-radius: 8px;
        color: white;
        font-weight: 600;
        cursor: pointer;
        font-size: 13px;
        transition: background-color 0.15s;
    }

    .seat-available {
        background-color: #28a745;
    }

        .seat-available:hover {
            background-color: #218838;
        }

    .seat-booked {
        background-color: #dc3545;
        cursor: not-allowed;
        opacity: 0.75;
    }

    .seat-selected {
        background-color: #0037b0 !important;
        box-shadow: 0 0 0 3px #dce1ff;
    }

    @@media (max-width: 767px) {
        .seat-map-card {
            position: static;
            margin-top: 6px;
        }
    }
</style>

<div class="page-head">
    <h2>New Passenger Booking</h2>
    <div class="sub">Choose a trip, set the stops, add passenger details and pick seats</div>
</div>

<form asp-controller="Booking" asp-action="Create" method="post">

    <div asp-validation-summary="All" class="text-danger mb-3"></div>

    <div class="row">

        <!-- LEFT SIDE: Form Fields -->
        <div class="col-md-7">

            <div class="form-card">
                <h3 class="card-title">Trip and stops</h3>

                <div class="mb-3">
                    <label class="form-label">Select Trip</label>
                    <select asp-for="TripId" id="tripSelect" class="form-control">
                        <option value="">-- Select Trip --</option>
                        @foreach (var trip in Model.TripList!)
                        {
                            <option value="@trip.TripId">
                                @trip.Bus?.BusNumber | @trip.Route?.OriginCity?.CityName → @trip.Route?.DestinationCity?.CityName
                                | @trip.DepartureDate.ToString("dd-MMM-yyyy") @trip.DepartureTime
                                | Seats Left: @trip.AvailableSeats
                            </option>
                        }
                    </select>
                    <span asp-validation-for="TripId" class="text-danger"></span>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Boarding Stop</label>
                        <select asp-for="BoardingStopId" id="boardingSelect" class="form-control">
                            <option value="">-- Please select a trip first. --</option>
                        </select>
                        <span asp-validation-for="BoardingStopId" class="text-danger"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label class="form-label">Drop Stop</label>
                        <select asp-for="DropStopId" id="dropSelect" class="form-control">
                            <option value="">-- Please select a boarding stop first. --</option>
                        </select>
                        <span asp-validation-for="DropStopId" class="text-danger"></span>
                    </div>
                </div>
            </div>

            <div class="form-card">
                <h3 class="card-title">Passenger details</h3>

                <div class="mb-3">
                    <label asp-for="PassengerName" class="form-label"></label>
                    <input asp-for="PassengerName" class="form-control" placeholder="e.g. Ahmed Khan + Family" />
                    <span asp-validation-for="PassengerName" class="text-danger"></span>
                </div>

                <div class="mb-1">
                    <label asp-for="PassengerPhone" class="form-label"></label>
                    <input asp-for="PassengerPhone" class="form-control" />
                    <span asp-validation-for="PassengerPhone" class="text-danger"></span>
                </div>
            </div>

            <!-- Selected seats yahan hidden inputs ke tor pe add/remove honge JavaScript se -->
            <div id="hiddenSeatInputs"></div>

            <div id="selectedSeatsSummary">No seat has been selected yet..</div>
            <span asp-validation-for="SelectedSeats" class="text-danger"></span>

            <div class="form-actions">
                <button type="submit" class="btn btn-brand">Save Booking</button>
                <a asp-controller="Booking" asp-action="Index" class="btn btn-soft">Cancel</a>
            </div>

        </div>

        <!-- RIGHT SIDE: Seat Map -->
        <div class="col-md-5">

            <div class="seat-map-card">
                <h3 class="card-title">Select Seat(s)</h3>
                <div class="hint">Multiple seats can be selected (for family/group bookings).</div>

                <div class="seat-legend">
                    <div class="legend-item"><div class="legend-box legend-available"></div> Available</div>
                    <div class="legend-item"><div class="legend-box legend-booked"></div> Booked</div>
                    <div class="legend-item"><div class="legend-box legend-selected"></div> Selected</div>
                </div>

                <div class="bus-body">
                    <div class="driver-box">🚌 Driver</div>
                    <div class="seat-map-scroll-area">
                        <div id="seatMapContainer">
                            <p class="text-muted">Please select a trip first.</p>
                        </div>
                    </div>
                </div>
            </div>

        </div>

    </div>

</form>

@section Scripts {
    <script>
        const tripSelect = document.getElementById("tripSelect");
        const boardingSelect = document.getElementById("boardingSelect");
        const dropSelect = document.getElementById("dropSelect");
        const seatMapContainer = document.getElementById("seatMapContainer");
        const hiddenSeatInputs = document.getElementById("hiddenSeatInputs");
        const selectedSeatsSummary = document.getElementById("selectedSeatsSummary");

        // Ye Set (unique list) selected seats ko track karega
        let selectedSeats = new Set();

        tripSelect.addEventListener("change", function() {
            const tripId = tripSelect.value;

            boardingSelect.innerHTML = '<option value="">-- Loading... --</option>';
            dropSelect.innerHTML = '<option value="">-- Please select a boarding stop first. --</option>';
            seatMapContainer.innerHTML = '<p class="text-muted">Loading seats...</p>';

            selectedSeats.clear();
            updateHiddenInputs();
            updateSummary();

            if (!tripId) {
                boardingSelect.innerHTML = '<option value="">-- Please select a trip first. --</option>';
                seatMapContainer.innerHTML = '<p class="text-muted">Please select a trip first.</p>';
                return;
            }

            fetch(`/Booking/GetStopsForTrip?tripId=${tripId}`)
                .then(response => response.json())
                .then(stops => {
                    let optionsHtml = '<option value="">-- Select Stop --</option>';
                    stops.forEach(stop => {
                        optionsHtml += `<option value="${stop.routeStopId}" data-order="${stop.stopOrder}">${stop.stopName}</option>`;
                    });
                    boardingSelect.innerHTML = optionsHtml;
                    dropSelect.innerHTML = '<option value="">-- Please select a boarding stop first. --</option>';
                });

            fetch(`/Booking/GetSeatMapForTrip?tripId=${tripId}`)
                .then(response => response.json())
                .then(data => {
                    renderSeatMap(data.totalSeats, data.bookedSeats);
                });
        });

        boardingSelect.addEventListener("change", function() {
            const selectedOption = boardingSelect.options[boardingSelect.selectedIndex];
            const boardingOrder = parseInt(selectedOption.getAttribute("data-order"));

            if (!boardingSelect.value) {
                dropSelect.innerHTML = '<option value="">-- Please select a boarding stop first. --</option>';
                return;
            }

            let dropOptionsHtml = '<option value="">-- Select Drop Stop --</option>';
            for (let option of boardingSelect.options) {
                if (option.value === "") continue;
                const optOrder = parseInt(option.getAttribute("data-order"));
                if (optOrder > boardingOrder) {
                    dropOptionsHtml += `<option value="${option.value}">${option.text}</option>`;
                }
            }
            dropSelect.innerHTML = dropOptionsHtml;
        });

        function renderSeatMap(totalSeats, bookedSeats) {
            if (totalSeats === 0) {
                seatMapContainer.innerHTML = '<p class="text-danger">Seat info not available.</p>';
                return;
            }

            let html = "";
            let seatNum = 1;

            while (seatNum <= totalSeats) {
                html += '<div class="seat-row">';

                for (let col = 0; col < 4; col++) {
                    if (col === 2) {
                        html += '<div></div>';
                    }

                    if (seatNum <= totalSeats) {
                        const isBooked = bookedSeats.includes(seatNum);
                        const seatClass = isBooked ? "seat-booked" : "seat-available";
                        const disabledAttr = isBooked ? "disabled" : "";

                        html += `<button type="button" class="seat-btn ${seatClass}" data-seat="${seatNum}" ${disabledAttr}>${seatNum}</button>`;
                        seatNum++;
                    } else {
                        html += '<div></div>';
                    }
                }

                html += '</div>';
            }

            seatMapContainer.innerHTML = html;

            // Click event: toggle select/deselect
            document.querySelectorAll('.seat-btn:not([disabled])').forEach(btn => {
                btn.addEventListener('click', function() {
                    const seatNumber = parseInt(this.getAttribute('data-seat'));

                    if (selectedSeats.has(seatNumber)) {
                        // Already selected — deselect karo
                        selectedSeats.delete(seatNumber);
                        this.classList.remove('seat-selected');
                        this.classList.add('seat-available');
                    } else {
                        // Naya select karo
                        selectedSeats.add(seatNumber);
                        this.classList.remove('seat-available');
                        this.classList.add('seat-selected');
                    }

                    updateHiddenInputs();
                    updateSummary();
                });
            });
        }

        function updateHiddenInputs() {
            // Purane hidden inputs saaf karo, naye banao
            hiddenSeatInputs.innerHTML = "";

            selectedSeats.forEach(seatNum => {
                const input = document.createElement("input");
                input.type = "hidden";
                input.name = "SelectedSeats";
                input.value = seatNum;
                hiddenSeatInputs.appendChild(input);
            });
        }

        function updateSummary() {
            if (selectedSeats.size === 0) {
                selectedSeatsSummary.textContent = "No seat has been selected yet.";
                return;
            }

            const sortedSeats = Array.from(selectedSeats).sort((a, b) => a - b);
            selectedSeatsSummary.textContent =
                `Selected Seats: ${sortedSeats.join(", ")} (${sortedSeats.length} seat${sortedSeats.length > 1 ? 's' : ''})`;
        }
    </script>
}
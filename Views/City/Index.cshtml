@model List<BusReservationERP.Models.City>

@{
    ViewData["Title"] = "City List";
}

<style>
    .page-head {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 12px;
        margin-bottom: 20px;
    }

        .page-head h2 {
            font-size: 22px;
            font-weight: 700;
            color: #0b1c30;
            margin: 0;
        }

        .page-head .sub {
            font-size: 13px;
            color: #747685;
            margin-top: 2px;
        }

    .btn-brand {
        background: #0037b0;
        color: #fff;
        border: none;
        border-radius: 8px;
        font-weight: 600;
        font-size: 14px;
        padding: 9px 18px;
    }

        .btn-brand:hover {
            background: #00247d;
            color: #fff;
        }

    .stat-row {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(170px, 1fr));
        gap: 14px;
        margin-bottom: 20px;
    }

    .stat-box {
        background: #fff;
        border-radius: 10px;
        box-shadow: 0 1px 6px rgba(0,0,0,0.06);
        padding: 14px 18px;
        border-left: 4px solid #0037b0;
    }

        .stat-box .num {
            font-size: 24px;
            font-weight: 700;
            color: #0b1c30;
            line-height: 1.1;
        }

        .stat-box .lbl {
            font-size: 13px;
            color: #747685;
        }

    .table-card {
        background: #fff;
        border-radius: 10px;
        box-shadow: 0 1px 6px rgba(0,0,0,0.06);
        overflow: hidden;
    }

        .table-card .table {
            margin: 0;
            font-size: 14px;
        }

        .table-card thead th {
            background: #eff4ff;
            color: #434655;
            font-weight: 600;
            font-size: 13px;
            border-bottom: 1px solid #dce9ff;
            padding: 12px 14px;
        }

        .table-card tbody td {
            padding: 12px 14px;
            vertical-align: middle;
            color: #0b1c30;
            font-weight: 500;
            border-color: #eef1fa;
        }

        .table-card tbody tr:hover {
            background-color: #f8f9ff;
        }

    .empty-state {
        text-align: center;
        padding: 48px 16px;
        color: #747685;
    }

        .empty-state .big {
            font-size: 16px;
            font-weight: 600;
            color: #0b1c30;
            margin-bottom: 4px;
        }
</style>

<div class="page-head">
    <div>
        <h2>City List</h2>
        <div class="sub">Cities available for routes and stops</div>
    </div>
    <a asp-controller="City" asp-action="Create" class="btn btn-brand">+ Add New City</a>
</div>

<div class="stat-row">
    <div class="stat-box">
        <div class="num">@Model.Count</div>
        <div class="lbl">Total cities</div>
    </div>
</div>

<div class="table-card">
    <table class="table">
        <thead>
            <tr>
                <th>City Name</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Count == 0)
            {
                <tr>
                    <td>
                        <div class="empty-state">
                            <div class="big">No cities added yet</div>
                            <div>Add a city before creating routes.</div>
                        </div>
                    </td>
                </tr>
            }

            @foreach (var city in Model)
            {
                <tr>
                    <td>@city.CityName</td>
                </tr>
            }
        </tbody>
    </table>
</div>
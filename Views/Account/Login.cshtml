@model BusReservationERP.ViewModels.LoginViewModel

@{
    ViewData["Title"] = "Admin Login";
}

<style>
    .login-shell {
        min-height: calc(100vh - 48px);
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .login-card {
        display: grid;
        grid-template-columns: 1.05fr 1fr;
        width: 100%;
        max-width: 920px;
        background: #fff;
        border-radius: 16px;
        overflow: hidden;
        box-shadow: 0 8px 30px rgba(0,55,176,0.12);
    }

    /* ===== Left brand panel ===== */
    .brand-panel {
        background: linear-gradient(150deg, #0037b0 0%, #00247d 100%);
        color: #fff;
        padding: 44px 38px;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        gap: 32px;
    }

        .brand-panel .logo {
            width: 52px;
            height: 52px;
            border-radius: 12px;
            background: rgba(255,255,255,0.16);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 26px;
            margin-bottom: 18px;
        }

        .brand-panel h1 {
            font-size: 26px;
            font-weight: 700;
            margin: 0 0 8px 0;
            line-height: 1.2;
        }

        .brand-panel .tagline {
            font-size: 14px;
            color: #c9d6ff;
            line-height: 1.6;
            margin: 0;
        }

    .feature-list {
        list-style: none;
        margin: 0;
        padding: 0;
        display: flex;
        flex-direction: column;
        gap: 14px;
    }

        .feature-list li {
            display: flex;
            align-items: flex-start;
            gap: 12px;
            font-size: 14px;
            color: #e3eaff;
            line-height: 1.5;
        }

        .feature-list .f-icon {
            width: 34px;
            height: 34px;
            border-radius: 9px;
            background: rgba(255,255,255,0.14);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 16px;
            flex-shrink: 0;
        }

        .feature-list strong {
            display: block;
            color: #fff;
            font-weight: 600;
            font-size: 14px;
        }

    /* ===== Right form panel ===== */
    .form-panel {
        padding: 44px 40px;
        display: flex;
        flex-direction: column;
        justify-content: center;
    }

    .mobile-brand {
        display: none;
        align-items: center;
        gap: 10px;
        margin-bottom: 22px;
    }

        .mobile-brand .m-icon {
            width: 38px;
            height: 38px;
            border-radius: 10px;
            background: #0037b0;
            color: #fff;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 19px;
        }

        .mobile-brand .m-title {
            font-weight: 700;
            font-size: 16px;
            color: #0b1c30;
        }

    .form-panel h2 {
        font-size: 24px;
        font-weight: 700;
        color: #0b1c30;
        margin: 0 0 6px 0;
    }

    .form-panel .lead-text {
        font-size: 14px;
        color: #747685;
        margin: 0 0 24px 0;
    }

    .login-form .form-label {
        font-size: 13px;
        font-weight: 600;
        color: #434655;
        margin-bottom: 6px;
    }

    .login-form .form-control {
        border: 1px solid #d5dbec;
        border-radius: 8px;
        padding: 11px 14px;
        font-size: 14px;
        color: #0b1c30;
        background-color: #f8f9ff;
    }

        .login-form .form-control:focus {
            background-color: #fff;
            border-color: #0037b0;
            box-shadow: 0 0 0 3px #dce1ff;
        }

    .login-form .text-danger {
        font-size: 13px;
    }

    /* Login error box (validation summary) */
    .login-form .validation-summary-errors {
        background: #fde2e4;
        border: 1px solid #f5c2c7;
        border-left: 4px solid #dc3545;
        border-radius: 8px;
        padding: 10px 14px;
        margin-bottom: 18px;
        color: #b02a37;
        font-size: 13px;
    }

        .login-form .validation-summary-errors ul {
            margin: 0;
            padding-left: 18px;
        }

    .pw-wrap {
        position: relative;
    }

        .pw-wrap .form-control {
            padding-right: 70px;
        }

    .pw-toggle {
        position: absolute;
        right: 8px;
        top: 50%;
        transform: translateY(-50%);
        background: transparent;
        border: none;
        color: #0037b0;
        font-size: 13px;
        font-weight: 600;
        padding: 4px 8px;
        border-radius: 6px;
        cursor: pointer;
    }

        .pw-toggle:hover {
            background: #eff4ff;
        }

    .btn-login {
        background: #0037b0;
        color: #fff;
        border: none;
        border-radius: 8px;
        font-weight: 600;
        font-size: 15px;
        padding: 12px;
        width: 100%;
        margin-top: 6px;
        transition: background-color 0.15s;
    }

        .btn-login:hover {
            background: #00247d;
            color: #fff;
        }

    .login-foot {
        margin-top: 22px;
        font-size: 12px;
        color: #747685;
        text-align: center;
    }

    @@media (max-width: 767px) {
        .login-shell {
            min-height: auto;
            align-items: flex-start;
            padding-top: 10px;
        }

        .login-card {
            grid-template-columns: 1fr;
        }

        .brand-panel {
            display: none;
        }

        .mobile-brand {
            display: flex;
        }

        .form-panel {
            padding: 30px 22px;
        }
    }
</style>

<div class="login-shell">
    <div class="login-card">

        <!-- LEFT: Brand panel -->
        <div class="brand-panel">
            <div>
                <div class="logo">🚌</div>
                <h1>BusReservationERP</h1>
                <p class="tagline">One place to run your fleet, schedule trips and take bookings.</p>
            </div>

            <ul class="feature-list">
                <li>
                    <span class="f-icon">💺</span>
                    <span><strong>Live seat maps</strong>See booked and free seats for every trip.</span>
                </li>
                <li>
                    <span class="f-icon">🎟️</span>
                    <span><strong>Group bookings</strong>Reserve several seats for a family in one go.</span>
                </li>
                <li>
                    <span class="f-icon">💰</span>
                    <span><strong>Payment tracking</strong>Know what is paid, partial or still pending.</span>
                </li>
            </ul>
        </div>

        <!-- RIGHT: Login form -->
        <div class="form-panel">

            <div class="mobile-brand">
                <div class="m-icon">🚌</div>
                <div class="m-title">BusReservationERP</div>
            </div>

            <h2>Welcome back</h2>
            <p class="lead-text">Sign in to the admin panel to continue.</p>

            <form asp-controller="Account" asp-action="Login" method="post" class="login-form">

                <div asp-validation-summary="All" class="text-danger"></div>

                <div class="mb-3">
                    <label asp-for="Email" class="form-label"></label>
                    <input asp-for="Email" class="form-control" placeholder="admin@example.com" autocomplete="username" autofocus />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Password" class="form-label"></label>
                    <div class="pw-wrap">
                        <input asp-for="Password" type="password" class="form-control" placeholder="Enter your password" autocomplete="current-password" />
                        <button type="button" class="pw-toggle" id="pwToggle">Show</button>
                    </div>
                    <span asp-validation-for="Password" class="text-danger"></span>
                </div>

                <button type="submit" class="btn btn-login">Sign in</button>

            </form>

            <div class="login-foot">Authorised staff only</div>
        </div>

    </div>
</div>

@section Scripts {
    <script>
        (function() {
            var pw = document.getElementById("Password");
            var toggle = document.getElementById("pwToggle");

            if (!pw || !toggle) return;

            toggle.addEventListener("click", function() {
                var show = pw.type === "password";
                pw.type = show ? "text" : "password";
                toggle.textContent = show ? "Hide" : "Show";
            });
        })();
    </script>
}
@model List<BusReservationERP.Models.Bus>

@{
    ViewData["Title"] = "Bus List";
}

<style>
    .page-head {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 12px;
        margin-bottom: 20px;
    }

        .page-head h2 {
            font-size: 22px;
            font-weight: 700;
            color: #0b1c30;
            margin: 0;
        }

        .page-head .sub {
            font-size: 13px;
            color: #747685;
            margin-top: 2px;
        }

    .btn-brand {
        background: #0037b0;
        color: #fff;
        border: none;
        border-radius: 8px;
        font-weight: 600;
        font-size: 14px;
        padding: 9px 18px;
    }

        .btn-brand:hover {
            background: #00247d;
            color: #fff;
        }

    .stat-row {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(170px, 1fr));
        gap: 14px;
        margin-bottom: 20px;
    }

    .stat-box {
        background: #fff;
        border-radius: 10px;
        box-shadow: 0 1px 6px rgba(0,0,0,0.06);
        padding: 14px 18px;
        border-left: 4px solid #0037b0;
    }

        .stat-box .num {
            font-size: 24px;
            font-weight: 700;
            color: #0b1c30;
            line-height: 1.1;
        }

        .stat-box .lbl {
            font-size: 13px;
            color: #747685;
        }

    .table-card {
        background: #fff;
        border-radius: 10px;
        box-shadow: 0 1px 6px rgba(0,0,0,0.06);
        overflow: hidden;
    }

        .table-card .table {
            margin: 0;
            font-size: 14px;
        }

        .table-card thead th {
            background: #eff4ff;
            color: #434655;
            font-weight: 600;
            font-size: 13px;
            border-bottom: 1px solid #dce9ff;
            padding: 12px 14px;
            white-space: nowrap;
        }

        .table-card tbody td {
            padding: 12px 14px;
            vertical-align: middle;
            color: #0b1c30;
            border-color: #eef1fa;
        }

        .table-card tbody tr:hover {
            background-color: #f8f9ff;
        }

    .bus-number {
        font-weight: 600;
    }

    .type-chip {
        display: inline-block;
        background: #dce9ff;
        color: #0037b0;
        font-weight: 600;
        font-size: 12px;
        border-radius: 6px;
        padding: 3px 10px;
    }

    .pill {
        display: inline-block;
        border-radius: 999px;
        font-size: 12px;
        font-weight: 600;
        padding: 4px 12px;
        white-space: nowrap;
    }

    .pill-active {
        background: #d1f2de;
        color: #146c43;
    }

    .pill-maintenance {
        background: #fff0c2;
        color: #8a6100;
    }

    .pill-inactive {
        background: #e9ebf3;
        color: #434655;
    }

    .pill-other {
        background: #dce9ff;
        color: #0037b0;
    }

    .btn-edit {
        background: #eff4ff;
        color: #0037b0;
        border: 1px solid #dce9ff;
        border-radius: 6px;
        font-size: 13px;
        font-weight: 600;
        padding: 4px 14px;
    }

        .btn-edit:hover {
            background: #0037b0;
            color: #fff;
            border-color: #0037b0;
        }

    .empty-state {
        text-align: center;
        padding: 48px 16px;
        color: #747685;
    }

        .empty-state .big {
            font-size: 16px;
            font-weight: 600;
            color: #0b1c30;
            margin-bottom: 4px;
        }

    @@media (max-width: 767px) {
        .table-card {
            overflow-x: auto;
        }
    }
</style>

<div class="page-head">
    <div>
        <h2>Bus List</h2>
        <div class="sub">Manage your fleet and seat capacity</div>
    </div>
    <a asp-controller="Bus" asp-action="Create" class="btn btn-brand">+ Add New Bus</a>
</div>

<div class="stat-row">
    <div class="stat-box">
        <div class="num">@Model.Count</div>
        <div class="lbl">Total buses</div>
    </div>
    <div class="stat-box">
        <div class="num">@Model.Sum(b => b.TotalSeats)</div>
        <div class="lbl">Total seats in fleet</div>
    </div>
</div>

<div class="table-card">
    <table class="table">
        <thead>
            <tr>
                <th>Bus Number</th>
                <th>Type</th>
                <th>Total Seats</th>
                <th>Status</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Count == 0)
            {
                <tr>
                    <td colspan="5">
                        <div class="empty-state">
                            <div class="big">No buses added yet</div>
                            <div>Add your first bus to start creating routes and trips.</div>
                        </div>
                    </td>
                </tr>
            }

            @foreach (var bus in Model)
            {
                <tr>
                    <td class="bus-number">@bus.BusNumber</td>
                    <td><span class="type-chip">@bus.BusType</span></td>
                    <td>@bus.TotalSeats</td>
                    <td>
                        @{
                            var status = bus.Status?.ToString() ?? "";
                            var pillClass = status.ToLower() switch
                            {
                                "active" => "pill-active",
                                "maintenance" => "pill-maintenance",
                                "inactive" => "pill-inactive",
                                _ => "pill-other"
                            };
                        }
                        <span class="pill @pillClass">@bus.Status</span>
                    </td>
                    <td>
                        <a asp-controller="Bus" asp-action="Edit" asp-route-id="@bus.BusId" class="btn btn-sm btn-edit">Edit</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
@model BusReservationERP.ViewModels.TripViewModel

@{
    ViewData["Title"] = "Edit Trip";
}

<style>
    .page-head {
        margin-bottom: 20px;
    }

        .page-head h2 {
            font-size: 22px;
            font-weight: 700;
            color: #0b1c30;
            margin: 0;
        }

        .page-head .sub {
            font-size: 13px;
            color: #747685;
            margin-top: 2px;
        }

    .form-card {
        background: #fff;
        border-radius: 10px;
        box-shadow: 0 1px 6px rgba(0,0,0,0.06);
        padding: 24px;
        max-width: 720px;
        margin-bottom: 18px;
    }

        .form-card .card-title {
            font-size: 15px;
            font-weight: 700;
            color: #0b1c30;
            margin: 0 0 16px 0;
            padding-bottom: 12px;
            border-bottom: 1px solid #eef1fa;
        }

        .form-card .form-label {
            font-size: 13px;
            font-weight: 600;
            color: #434655;
            margin-bottom: 6px;
        }

        .form-card .form-control {
            border: 1px solid #d5dbec;
            border-radius: 8px;
            padding: 10px 14px;
            font-size: 14px;
            color: #0b1c30;
            background-color: #f8f9ff;
        }

            .form-card .form-control:focus {
                background-color: #fff;
                border-color: #0037b0;
                box-shadow: 0 0 0 3px #dce1ff;
            }

        .form-card .text-danger {
            font-size: 13px;
        }

    .form-actions {
        display: flex;
        gap: 10px;
        max-width: 720px;
    }

    .btn-brand {
        background: #0037b0;
        color: #fff;
        border: none;
        border-radius: 8px;
        font-weight: 600;
        font-size: 14px;
        padding: 10px 24px;
    }

        .btn-brand:hover {
            background: #00247d;
            color: #fff;
        }

    .btn-soft {
        background: #eff4ff;
        color: #434655;
        border: 1px solid #dce9ff;
        border-radius: 8px;
        font-weight: 500;
        font-size: 14px;
        padding: 10px 24px;
    }

        .btn-soft:hover {
            background: #dce9ff;
            color: #0b1c30;
        }
</style>

<div class="page-head">
    <h2>Edit Trip</h2>
    <div class="sub">Update the bus, route, schedule or fare for this trip</div>
</div>

<form asp-controller="Trip" asp-action="Edit" method="post">

    <input type="hidden" asp-for="TripId" />

    <div asp-validation-summary="All" class="text-danger mb-3"></div>

    <div class="form-card">
        <h3 class="card-title">Bus and route</h3>

        <div class="row">
            <div class="col-md-6 mb-3">
                <label class="form-label">Select Bus</label>
                <select asp-for="BusId" class="form-control">
                    <option value="">-- Select Bus --</option>
                    @foreach (var bus in Model.BusList!)
                    {
                        <option value="@bus.BusId">@bus.BusNumber (@bus.BusType)</option>
                    }
                </select>
                <span asp-validation-for="BusId" class="text-danger"></span>
            </div>

            <div class="col-md-6 mb-3">
                <label class="form-label">Select Route</label>
                <select asp-for="RouteId" class="form-control">
                    <option value="">-- Select Route --</option>
                    @foreach (var route in Model.RouteList!)
                    {
                        <option value="@route.RouteId">@route.OriginCity?.CityName → @route.DestinationCity?.CityName</option>
                    }
                </select>
                <span asp-validation-for="RouteId" class="text-danger"></span>
            </div>
        </div>
    </div>

    <div class="form-card">
        <h3 class="card-title">Schedule and fare</h3>

        <div class="row">
            <div class="col-md-4 mb-3">
                <label asp-for="DepartureDate" class="form-label"></label>
                <input asp-for="DepartureDate" class="form-control" />
                <span asp-validation-for="DepartureDate" class="text-danger"></span>
            </div>

            <div class="col-md-4 mb-3">
                <label asp-for="DepartureTime" class="form-label"></label>
                <input asp-for="DepartureTime" class="form-control" />
                <span asp-validation-for="DepartureTime" class="text-danger"></span>
            </div>

            <div class="col-md-4 mb-3">
                <label asp-for="Fare" class="form-label"></label>
                <input asp-for="Fare" class="form-control" />
                <span asp-validation-for="Fare" class="text-danger"></span>
            </div>
        </div>
    </div>

    <div class="form-actions">
        <button type="submit" class="btn btn-brand">Update Trip</button>
        <a asp-controller="Trip" asp-action="Index" class="btn btn-soft">Cancel</a>
    </div>

</form>
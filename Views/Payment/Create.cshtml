@model BusReservationERP.Models.Payment

@{
    ViewData["Title"] = "Record Payment";
}

<style>
    .page-head {
        margin-bottom: 20px;
    }

        .page-head h2 {
            font-size: 22px;
            font-weight: 700;
            color: #0b1c30;
            margin: 0;
        }

        .page-head .sub {
            font-size: 13px;
            color: #747685;
            margin-top: 2px;
        }

    .booking-info {
        background: #eff4ff;
        border: 1px solid #dce9ff;
        border-left: 4px solid #0037b0;
        border-radius: 10px;
        padding: 16px 20px;
        max-width: 560px;
        margin-bottom: 18px;
    }

        .booking-info .row-item {
            display: flex;
            justify-content: space-between;
            gap: 16px;
            font-size: 14px;
            padding: 4px 0;
        }

        .booking-info .key {
            color: #747685;
        }

        .booking-info .val {
            color: #0b1c30;
            font-weight: 600;
            text-align: right;
        }

    .form-card {
        background: #fff;
        border-radius: 10px;
        box-shadow: 0 1px 6px rgba(0,0,0,0.06);
        padding: 28px;
        max-width: 560px;
    }

        .form-card .form-label {
            font-size: 13px;
            font-weight: 600;
            color: #434655;
            margin-bottom: 6px;
        }

        .form-card .form-control {
            border: 1px solid #d5dbec;
            border-radius: 8px;
            padding: 10px 14px;
            font-size: 14px;
            color: #0b1c30;
            background-color: #f8f9ff;
        }

            .form-card .form-control:focus {
                background-color: #fff;
                border-color: #0037b0;
                box-shadow: 0 0 0 3px #dce1ff;
            }

        .form-card .text-danger {
            font-size: 13px;
        }

    .form-actions {
        display: flex;
        gap: 10px;
        margin-top: 24px;
        padding-top: 20px;
        border-top: 1px solid #eef1fa;
    }

    .btn-brand {
        background: #0037b0;
        color: #fff;
        border: none;
        border-radius: 8px;
        font-weight: 600;
        font-size: 14px;
        padding: 10px 24px;
    }

        .btn-brand:hover {
            background: #00247d;
            color: #fff;
        }

    .btn-soft {
        background: #eff4ff;
        color: #434655;
        border: 1px solid #dce9ff;
        border-radius: 8px;
        font-weight: 500;
        font-size: 14px;
        padding: 10px 24px;
    }

        .btn-soft:hover {
            background: #dce9ff;
            color: #0b1c30;
        }
</style>

<div class="page-head">
    <h2>Record Payment</h2>
    <div class="sub">Enter the amount received for this booking</div>
</div>

<div class="booking-info">
    <div class="row-item">
        <span class="key">Passenger</span>
        <span class="val">@ViewBag.PassengerName</span>
    </div>
    <div class="row-item">
        <span class="key">Seats</span>
        <span class="val">@ViewBag.SeatNumbers (@ViewBag.SeatCount seats)</span>
    </div>
</div>

<div class="form-card">
    <form asp-controller="Payment" asp-action="Create" method="post">

        <input type="hidden" asp-for="BookingGroupId" />

        <div asp-validation-summary="All" class="text-danger mb-3"></div>

        <div class="mb-3">
            <label asp-for="Amount" class="form-label"></label>
            <input asp-for="Amount" class="form-control" />
            <span asp-validation-for="Amount" class="text-danger"></span>
        </div>

        <div class="row">
            <div class="col-md-6 mb-3">
                <label class="form-label">Payment Method</label>
                <select asp-for="Method" class="form-control">
                    <option value="Cash">Cash</option>
                    <option value="Card">Card</option>
                    <option value="Online">Online</option>
                </select>
            </div>

            <div class="col-md-6 mb-3">
                <label class="form-label">Payment Status</label>
                <select asp-for="Status" class="form-control">
                    <option value="Pending">Pending</option>
                    <option value="Paid">Paid</option>
                    <option value="Partial">Partial</option>
                </select>
            </div>
        </div>

        <div class="form-actions">
            <button type="submit" class="btn btn-brand">Save Payment</button>
            <a asp-controller="Booking" asp-action="Index" class="btn btn-soft">Cancel</a>
        </div>

    </form>
</div>